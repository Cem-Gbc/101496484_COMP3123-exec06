# Copy this file to .env and add your own MongoDB Atlas connection string.
# Never commit the real .env file.
DB_URL=mongodb+srv://<db_user>:<db_password>@<cluster-host>/week06_notes?retryWrites=true&w=majority
PORT=8081

# If you get "querySrv ECONNREFUSED", use the standard connection string from Atlas instead:
# DB_URL=mongodb://<db_user>:<db_password>@<shard-00-00-host>:27017,<shard-00-01-host>:27017,<shard-00-02-host>:27017/week06_notes?ssl=true&authSource=admin&replicaSet=<replica-set-name>&retryWrites=true&w=majority
